PORT=5000
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=air_quality_db
# Or set DATABASE_URL instead of DB_USER/DB_PASSWORD/DB_HOST/DB_PORT/DB_NAME
MONGODB_URI=mongodb://127.0.0.1:27017/airwatch
REDIS_URL=redis://127.0.0.1:6379
REPORT_UPLOAD_DIR=uploads/reports
# Optional reverse-geocoding endpoint for the Report Pollution live-location button.
# Defaults to OpenStreetMap Nominatim when omitted.
REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
JWT_SECRET=replace_this_with_a_long_random_string
# Local administrator created on first startup if it does not already exist
ADMIN_USERNAME=airwatch_admin
ADMIN_EMAIL=airwatch.admin@local
ADMIN_PASSWORD=Admin@123
